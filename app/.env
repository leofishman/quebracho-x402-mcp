# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> x402 ###
# Testnet only. PAY_TO is the author's wallet (Ombú seller on Arc); override it in .env.local.
X402_NETWORK=eip155:84532
X402_PRICE=0.01
X402_PAY_TO=0x7e510E6B4c3E2121CB64CD0686a4f241Df326510
X402_PAID_TOOLS=wisdom
# Only "mock" exists yet: signatures verified for real, nothing settled on chain.
X402_FACILITATOR=mock
# Chainalysis sanctions API key; empty = only our lists and OFAC's (app:screening).
X402_SCREENING_API_KEY=
# Seconds an API answer is kept, clean or sanctioned (86400 = a day).
X402_SCREENING_CACHE_TTL=86400
# Seconds to wait for the API, and what no answer means: reject or allow.
X402_SCREENING_TIMEOUT=3
X402_SCREENING_UNAVAILABLE=reject
###< x402 ###

###> app:ask ###
# The agent's LLM: any OpenAI-compatible server. Real values go in .env.local.
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=local
LLM_API_KEY=none
MCP_URL=https://quebracho-x402-mcp.ddev.site/mcp
# Buyer key: the unfunded web3.js docs key, enough for mock mode. Never a funded key here.
X402_BUYER_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a3f362318
# Spending cap per run on X402_NETWORK, in USD.
X402_BUDGET_USD=0.05
###< app:ask ###
